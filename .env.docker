# ============================================
# PMS Docker 部署环境变量配置
# ============================================
# 使用方式: docker-compose --env-file .env.docker up -d
# 安全提示: 请在部署前修改所有默认密码！
# ============================================

# ---------- 版本标识 ----------
# 用于镜像标签，升级时修改此值
PMS_VERSION=v1.0.0

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=pms_root_2026
MYSQL_DATABASE=pms
MYSQL_USER=pms
MYSQL_PASSWORD=pms_db_2026
# MySQL 数据持久化目录（宿主机路径）
MYSQL_DATA_DIR=./data/mysql
# MySQL 端口映射（宿主机:容器）
MYSQL_PORT=3306

# ---------- Redis 配置 ----------
REDIS_PASSWORD=pms_redis_2026
# Redis 数据持久化目录
REDIS_DATA_DIR=./data/redis
# Redis 端口映射
REDIS_PORT=6379

# ---------- 后端配置 ----------
# JVM 内存参数（根据服务器配置调整）
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
# 后端端口映射
BACKEND_PORT=8080
# 上传文件持久化目录
UPLOAD_DATA_DIR=./data/upload
# 日志持久化目录
LOG_DATA_DIR=./data/logs

# ---------- 前端配置 ----------
# 前端访问端口
FRONTEND_PORT=80

# ---------- Druid 监控配置 ----------
DRUID_USERNAME=admin
DRUID_PASSWORD=pms_druid_2026

# ---------- 备份配置 ----------
# 备份文件存储目录
BACKUP_DIR=./data/backup
# 备份保留天数
BACKUP_RETAIN_DAYS=30
