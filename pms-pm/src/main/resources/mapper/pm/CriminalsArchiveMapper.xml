<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pms.pm.mapper.CriminalsArchiveMapper">
    
    <resultMap type="CriminalsArchive" id="CriminalsArchiveResult">
        <result property="id"    column="id"    />
        <result property="uuid"    column="uuid"    />
        <result property="criminalNo"    column="criminal_no"    />
        <result property="criminalName"    column="criminal_name"    />
        <result property="basicInfoPath"    column="basic_info_path"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="createdBy"    column="created_by"    />
    </resultMap>

    <sql id="selectCriminalsArchiveVo">
        select id, uuid, criminal_no, criminal_name, basic_info_path, created_at, updated_at, created_by from t_criminals_archive
    </sql>

    <select id="selectCriminalsArchiveList" parameterType="CriminalsArchive" resultMap="CriminalsArchiveResult">
        <include refid="selectCriminalsArchiveVo"/>
        <where>  
            <if test="criminalNo != null  and criminalNo != ''"> and criminal_no = #{criminalNo}</if>
            <if test="criminalName != null  and criminalName != ''"> and criminal_name like concat('%', #{criminalName}, '%')</if>
            <if test="basicInfoPath != null  and basicInfoPath != ''"> and basic_info_path = #{basicInfoPath}</if>
        </where>
    </select>
    
    <select id="selectCriminalsArchiveById" parameterType="String" resultMap="CriminalsArchiveResult">
        <include refid="selectCriminalsArchiveVo"/>
        where id = #{id}
    </select>

    <insert id="insertCriminalsArchive" parameterType="CriminalsArchive" useGeneratedKeys="true" keyProperty="id">
        insert into t_criminals_archive
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="uuid != null and uuid != ''">uuid,</if>
            <if test="criminalNo != null and criminalNo != ''">criminal_no,</if>
            <if test="criminalName != null and criminalName != ''">criminal_name,</if>
            <if test="basicInfoPath != null">basic_info_path,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="createdBy != null">created_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="uuid != null and uuid != ''">#{uuid},</if>
            <if test="criminalNo != null and criminalNo != ''">#{criminalNo},</if>
            <if test="criminalName != null and criminalName != ''">#{criminalName},</if>
            <if test="basicInfoPath != null">#{basicInfoPath},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
         </trim>
    </insert>

    <update id="updateCriminalsArchive" parameterType="CriminalsArchive">
        update t_criminals_archive
        <trim prefix="SET" suffixOverrides=",">
            <if test="uuid != null and uuid != ''">uuid = #{uuid},</if>
            <if test="criminalNo != null and criminalNo != ''">criminal_no = #{criminalNo},</if>
            <if test="criminalName != null and criminalName != ''">criminal_name = #{criminalName},</if>
            <if test="basicInfoPath != null">basic_info_path = #{basicInfoPath},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCriminalsArchiveById" parameterType="String">
        delete from t_criminals_archive where id = #{id}
    </delete>

    <delete id="deleteCriminalsArchiveByIds" parameterType="String">
        delete from t_criminals_archive where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
